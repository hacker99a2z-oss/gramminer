{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gramminer-backend",
  "main": "backend/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  }
}
