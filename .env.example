# Vercel frontend (server-side only; do not add the VITE_ prefix)
BACKEND_URL=https://your-gramminer-backend.onrender.com

# Render backend
FRONTEND_URL=https://your-gramminer.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-secret
LOVABLE_API_KEY=replace-with-lovable-connector-key
TELEGRAM_API_KEY=replace-with-telegram-connector-api-key
ADSGRAM_REWARD_SECRET=replace-with-adsgram-reward-secret
PAYOUT_CRON_SECRET=replace-with-a-long-random-secret
TON_WALLET_MNEMONIC=word1 word2 word3 replace-with-your-real-wallet-mnemonic
TONCENTER_API_KEY=optional-toncenter-api-key
TON_WALLET_VERSION=v5r1
PAYMENT_PROOF_CHAT_ID=optional-telegram-channel-id
PAYMENTS_PROOF_URL=optional-https-payment-proof-url

# Used only when running Drizzle migrations from a trusted local machine.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
