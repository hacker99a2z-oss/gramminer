# Vercel static frontend: public API URL, contains no secret
VITE_BACKEND_URL=https://gramminer-backend.onrender.com

# Render backend: Turso/libSQL
FRONTEND_URL=https://play-for-win-bice.vercel.app
# Optional additional trusted origins, comma-separated
# FRONTEND_URLS=https://play-for-win-bice.vercel.app,https://your-preview.vercel.app
TURSO_DATABASE_URL=libsql://YOUR_DATABASE-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_AUTH_TOKEN
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_BOT_TOKEN
ADSGRAM_REWARD_SECRET=YOUR_RANDOM_ADSGRAM_CALLBACK_SECRET
PAYOUT_CRON_SECRET=YOUR_DIFFERENT_RANDOM_CRON_SECRET
TON_WALLET_MNEMONIC=YOUR_DEDICATED_PAYOUT_WALLET_MNEMONIC
TONCENTER_API_KEY=OPTIONAL_TONCENTER_API_KEY
TON_WALLET_VERSION=v5r1
PAYMENT_PROOF_CHAT_ID=@YOUR_PAYMENT_PROOF_CHANNEL
PAYMENTS_PROOF_URL=https://t.me/YOUR_PAYMENT_PROOF_CHANNEL

# Local-only: used once to copy existing Supabase data into Turso.
# Never add this value to Render or Vercel.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres


# Telegram bot /start welcome flow
PUBLIC_BACKEND_URL=https://gramminer-backend.onrender.com
BOT_APP_URL=https://play-for-win-bice.vercel.app
BOT_OFFICIAL_CHANNEL_URL=https://t.me/YOUR_OFFICIAL_CHANNEL
BOT_SUPPORT_GROUP_URL=https://t.me/YOUR_SUPPORT_GROUP
