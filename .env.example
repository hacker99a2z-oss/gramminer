# Cloudflare Pages build variable: point the browser at the Cloudflare Worker, never Render.
VITE_BACKEND_URL=https://YOUR-CLOUDFLARE-WORKER-HOST

# Cloudflare Pages Functions variable: Worker URL for public callback proxying.
BACKEND_URL=https://YOUR-CLOUDFLARE-WORKER-HOST

# Shared values used by Cloudflare Worker and Render. Use the existing production Turso database only after staging verification.
FRONTEND_URL=https://gramminer-c68.pages.dev
FRONTEND_URLS=https://gramminer-c68.pages.dev
TURSO_DATABASE_URL=libsql://YOUR_DATABASE-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_AUTH_TOKEN
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_BOT_TOKEN
ADSGRAM_REWARD_SECRET=YOUR_RANDOM_ADSGRAM_CALLBACK_SECRET
PAYOUT_CRON_SECRET=YOUR_DIFFERENT_RANDOM_CRON_SECRET

# Worker only: fixed Render origin used for the Telegram webhook and scheduled payout proxy.
RENDER_BACKEND_URL=https://gramminer-backend.onrender.com

# Render only. Never put either value in Cloudflare Pages VITE_* variables.
TON_WALLET_MNEMONIC=YOUR_DEDICATED_PAYOUT_WALLET_MNEMONIC
TONCENTER_API_KEY=OPTIONAL_TONCENTER_API_KEY
TON_WALLET_VERSION=v5r1
PAYMENT_PROOF_CHAT_ID=@YOUR_PAYMENT_PROOF_CHANNEL
PAYMENTS_PROOF_URL=https://t.me/YOUR_PAYMENT_PROOF_CHANNEL

# Render Telegram webhook: set to the exact Worker host after the Worker is deployed.
PUBLIC_BACKEND_URL=https://YOUR-CLOUDFLARE-WORKER-HOST
BOT_APP_URL=https://gramminer-c68.pages.dev
BOT_OFFICIAL_CHANNEL_URL=https://t.me/YOUR_OFFICIAL_CHANNEL
BOT_SUPPORT_GROUP_URL=https://t.me/YOUR_SUPPORT_GROUP

# Set true for one controlled Render restart only when intentionally registering the Telegram webhook.
TELEGRAM_AUTO_CONFIGURE_WEBHOOK=false

# Set on Render only after the Cloudflare Worker API has passed preview smoke tests.
EDGE_ONLY_API=false
